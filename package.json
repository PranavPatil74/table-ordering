{
  "name": "sandwich-express",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.mts",
    "cleanup:test-data": "node scripts/cleanup-test-data.mjs",
    "cleanup:test-menu": "node scripts/cleanup-test-menu.mjs",
    "test:supabase": "vitest run --config vitest.supabase.config.mts",
    "e2e": "node e2e/run.mjs",
    "e2e:build": "node e2e/run.mjs --build-only",
    "e2e:run": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm build",
    "verify:db": "pnpm test:db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
