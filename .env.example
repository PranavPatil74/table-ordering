# Sandwich Express environment variables
#
# Copy this file to `.env.local` and fill in real values:   cp .env.example .env.local
# NEVER commit `.env.local` or any file containing real keys (it is git-ignored).
# NEVER paste secret values into chat tools, issues or screenshots.
#
# Variables starting with NEXT_PUBLIC_ are embedded in browser JavaScript and visible to
# every visitor. They must never contain a secret. Everything else is server-only.
#
# The app validates these at startup (src/lib/env/schema.ts) and prints a readable list of
# problems. Placeholder values below are fine for local development but are rejected when
# NODE_ENV=production.

# ----------------------------------------------------------------------------
# Public (safe for the browser)
# ----------------------------------------------------------------------------

# Public origin of the site, used to build the table QR-code links (<origin>/menu?table=T05).
# Origin only: no path, no trailing slash needed. Production must use https://.
# Optional in development (defaults to http://localhost:3000); required in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase API URL.
#   Local Supabase (pnpm db:start):  http://127.0.0.1:54321
#   Hosted Supabase:                 https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase PUBLISHABLE key (also called the anon key). Designed to be public; access is
# controlled by Row Level Security. Local: printed by `pnpm db:status`. Hosted: Project
# Settings -> API keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ----------------------------------------------------------------------------
# Server-only secrets (never prefix these with NEXT_PUBLIC_)
# ----------------------------------------------------------------------------

# Address that table QR codes point to (<origin>/menu?table=T05). READ AT RUNTIME on the server, so
# it always reflects the server's current setting. NEXT_PUBLIC_APP_URL above is frozen into the build
# by Next.js, which is why QR codes use THIS variable when it is set. Leave it blank to fall back to
# NEXT_PUBLIC_APP_URL (fine for local development). In production set it to your public
# https:// origin; QR download and printing are refused while it points at localhost.
APP_BASE_URL=

# Supabase service role / secret key. Bypasses Row Level Security: used only in server code
# for payment finalisation and admin tasks. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay (test mode first). All three must be set together, or all left blank.
# Leave blank until you have created Razorpay test credentials; the app then reports that
# payments are not configured instead of pretending to take money.
#   RAZORPAY_KEY_ID          Dashboard -> Account & Settings -> API keys (rzp_test_...)
#   RAZORPAY_KEY_SECRET      Shown once when the key is generated
#   RAZORPAY_WEBHOOK_SECRET  A secret YOU choose when creating the webhook in the Dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
